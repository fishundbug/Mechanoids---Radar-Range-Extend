<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- 将反隐雷达的有效反隐半径从64提升至128 -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName="NCL_Overwatch_Nexus"]/comps/li[@Class="NCL.CompProperties_AntiInvisibilityField"]/effectiveRadius</xpath>
    <value>
      <effectiveRadius>128</effectiveRadius>
    </value>
  </Operation>

</Patch>
